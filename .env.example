# Copy to .env.local for local overrides. In production set these in Vercel
# (Settings > Environment Variables) and redeploy; Vite bakes them in at build time.

# Socket.IO game server, no trailing slash. REQUIRED for production builds.
# In dev it defaults to http://localhost:3001 when unset.
VITE_SERVER_URL=http://localhost:3001

# Optional: Socket.IO path on the server (default /socket.io)
# VITE_SOCKET_PATH=/socket.io

# Optional: public base path when served under a sub-path, e.g. /renga/ (default /)
# VITE_BASE=/

# Game server (set on the server, not in Vercel): comma-separated list of sites allowed to connect.
# Unset means any origin. Example: ALLOWED_ORIGINS=https://renga.azedlabs.com,http://localhost:5173
